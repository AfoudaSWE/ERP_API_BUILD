{
  "name": "ecom_interface",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/web/ecom-interface/src",
  "projectType": "application",
  "tags": ["scope:commerce", "platform:frontend", "runtime:browser", "type:app"],
  "targets": {
    "serve": { "executor": "nx:run-commands", "options": { "command": "vite --config apps/web/ecom-interface/vite.config.ts --configLoader runner" } },
    "build": { "executor": "nx:run-commands", "outputs": ["{workspaceRoot}/dist/apps/web/ecom-interface"], "options": { "command": "vite build --config apps/web/ecom-interface/vite.config.ts --configLoader runner" } },
    "lint": { "executor": "nx:run-commands", "options": { "command": "eslint apps/web/ecom-interface/src" } },
    "typecheck": { "executor": "nx:run-commands", "options": { "command": "tsc --noEmit -p apps/web/ecom-interface/tsconfig.json" } },
    "test": { "executor": "nx:run-commands", "options": { "command": "vitest run --config apps/web/ecom-interface/vite.config.ts --configLoader runner" } }
  }
}
