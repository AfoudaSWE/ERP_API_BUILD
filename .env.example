NODE_ENV=development
PORT=3333
DB_SCHEMA=erp
DATABASE_URL=postgresql://erp:replace-with-a-strong-password@localhost:5432/erp
JWT_SECRET=replace-this-with-at-least-32-random-characters
JWT_EXPIRES_IN=8h
REFRESH_TOKEN_DAYS=14
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175
VITE_API_URL=/api
VITE_DEMO_EMAIL=owner@demo.erp
VITE_DEMO_PASSWORD=
TRUST_PROXY=0
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000
DB_STATEMENT_TIMEOUT_MS=30000
SHUTDOWN_TIMEOUT_MS=15000
# OLLAMA_URL remains accepted as a backwards-compatible alias.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_TIMEOUT_MS=120000
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_TLS=false
REDIS_DB=0
REDIS_PREFIX=erp
WORKER_EMAIL_CONCURRENCY=5
WORKER_MEDIA_CONCURRENCY=2
WORKER_ORDER_CONCURRENCY=5
WORKER_INVENTORY_CONCURRENCY=5
WORKER_REPORT_CONCURRENCY=1
