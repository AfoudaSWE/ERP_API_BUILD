{
    "name":  "vision-camera-agent",
    "$schema":  "../../../node_modules/nx/schemas/project-schema.json",
    "projectType":  "application",
    "sourceRoot":  "apps/services/vision-camera-agent/src",
    "tags":  [
                 "scope:retail",
                 "platform:python",
                 "runtime:python",
                 "type:app"
             ],
    "targets":  {
                    "serve":  {
                                  "executor":  "nx:run-commands",
                                  "options":  {
                                                  "command":  "python -m vision_camera_agent.people_counter",
                                                  "cwd":  "apps/services/vision-camera-agent/src"
                                              }
                              },
                    "test":  {
                                 "executor":  "nx:run-commands",
                                 "options":  {
                                                 "command":  "python -m compileall -q src scripts",
                                                 "cwd":  "apps/services/vision-camera-agent"
                                             }
                             },
                    "lint":  {
                                 "executor":  "nx:run-commands",
                                 "options":  {
                                                 "command":  "python -m compileall -q src scripts",
                                                 "cwd":  "apps/services/vision-camera-agent"
                                             }
                             }
                }
}
