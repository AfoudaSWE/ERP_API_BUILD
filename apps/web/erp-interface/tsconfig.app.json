{
    "extends":  "../../../tsconfig.base.json",
    "compilerOptions":  {
                            "target":  "ES2020",
                            "lib":  [
                                        "DOM",
                                        "DOM.Iterable",
                                        "ESNext"
                                    ],
                            "module":  "ESNext",
                            "moduleResolution":  "Bundler",
                            "jsx":  "react-jsx",
                            "noEmit":  true,
                            "isolatedModules":  true,
                            "types":  [
                                          "vite/client"
                                      ],
                            "paths":  {
                                          "@/*":  [
                                                      "apps/web/erp-interface/src/*"
                                                  ],
                                          "@erp/contracts":  [
                                                                 "libs/shared/contracts/src/index.ts"
                                                             ],
                                          "@erp/commerce-catalog-contracts":  [
                                                                                  "libs/domains/commerce/catalog/contracts/src/index.ts"
                                                                              ],
                                          "@erp/shared-frontend-auth":  [
                                                                            "libs/frontend/auth/src/index.tsx"
                                                                        ],
                                          "@erp/shared-frontend-data-access":  [
                                                                                   "libs/frontend/data-access/src/index.ts"
                                                                               ]
                                      }
                        },
    "include":  [
                    "src/**/*.ts",
                    "src/**/*.tsx",
                    "vite.config.ts"
                ]
}