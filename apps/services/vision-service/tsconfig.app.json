{
    "extends":  "../../../tsconfig.base.json",
    "compilerOptions":  {
                            "rootDir":  "./src",
                            "outDir":  "../../../dist/apps/services/vision-service",
                            "types":  [
                                          "node"
                                      ],
                            "module":  "commonjs",
                            "moduleResolution":  "node",
                            "experimentalDecorators":  true,
                            "emitDecoratorMetadata":  true
                        },
    "include":  [
                    "src/**/*.ts"
                ],
    "exclude":  [
                    "src/**/*.spec.ts"
                ]
}