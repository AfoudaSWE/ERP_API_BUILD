{
  "name": "ai-powered-sme-erp-platform",
  "private": true,
  "scripts": {
    "dev": "nx run-many -t serve --projects=erp_interface,erp_api --parallel=2",
    "dev:all": "concurrently --kill-others-on-fail --names ERP,ECOM,API,AUTOMATION,RETAIL,VISION,WORKER --prefix-colors blue,magenta,yellow,cyan,green,white,gray \"npm run dev:erp_interface\" \"npm run serve:ecom_interface\" \"npm run serve:erp_api\" \"npm run serve:automation-api\" \"npm run dev:retail_ms_interface\" \"npm run serve:vision-service\" \"npm run serve:worker\"",
    "dev:erp_interface": "nx serve erp_interface",
    "dev:erp_api": "nx serve erp_api",
    "dev:ecommerce": "concurrently --kill-others-on-fail --names STOREFRONT,API --prefix-colors magenta,yellow \"npm run serve:ecom_interface\" \"npm run serve:erp_api\"",
    "dev:ecom_interface": "nx serve ecom_interface",
    "serve:ecom_interface": "nx serve ecom_interface",
    "serve:erp_api": "nx serve erp_api",
    "serve:automation-api": "nx serve automation-api",
    "dev:retail_ms_interface": "nx serve retail_ms_interface",
    "serve:vision-service": "nx serve vision-service",
    "serve:vision-camera-agent": "nx serve vision-camera-agent",
    "serve:worker": "nx serve worker",
    "start:cam-api": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./apps/services/vision-camera-agent/scripts/start-backend.ps1",
    "start:cameras": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./apps/services/vision-camera-agent/scripts/start-cameras.ps1",
    "redis:up": "docker compose up -d redis",
    "build": "nx run-many -t build --all",
    "build:ecommerce": "nx run-many -t build --projects=ecom_interface,erp_api",
    "build:ecom_interface": "nx build ecom_interface",
    "build:worker": "nx build worker",
    "test": "nx run-many -t test --all",
    "test:ecommerce": "nx run-many -t test --projects=ecom_interface,erp_api",
    "test:ecom_interface": "nx test ecom_interface",
    "test:commerce": "nx run-many -t test --projects=commerce-catalog-contracts,commerce-catalog-application,erp_api",
    "test:jobs": "nx run-many -t test --projects=jobs-core,jobs-producers,jobs-processors,worker",
    "e2e": "playwright test",
    "lint": "nx run-many -t lint --all",
    "lint:ecommerce": "nx run-many -t lint --projects=ecom_interface,erp_api",
    "lint:ecom_interface": "nx lint ecom_interface",
    "typecheck": "nx run-many -t typecheck --all",
    "typecheck:ecommerce": "nx run-many -t typecheck --projects=ecom_interface,erp_api",
    "typecheck:ecom_interface": "nx typecheck ecom_interface",
    "check:ecommerce": "npm run lint:ecommerce && npm run typecheck:ecommerce && npm run test:ecommerce && npm run build:ecommerce",
    "check:production": "nx run-many -t lint --projects=erp_api,erp_interface,worker,jobs-core,jobs-producers,jobs-processors,commerce-catalog-contracts,commerce-catalog-application && nx run-many -t typecheck --all && nx run-many -t build --projects=erp_api,erp_interface,worker && npm audit --omit=dev",
    "graph": "nx graph",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "nx run erp_api:migrate",
    "db:seed": "nx run erp_api:seed",
    "db:seed:business": "nx run erp_api:seed-business",
    "db:seed:storefront": "nx run erp_api:seed-storefront",
    "db:setup:ecommerce": "npm run db:up && npm run db:migrate && npm run db:seed && npm run db:seed:storefront",
    "db:seed:demo": "npm run db:seed && npm run db:seed:storefront",
    "db:seed:accounting": "nx run erp_api:seed-accounting",
    "db:reset": "nx run erp_api:reset",
    "db:setup": "npm run db:up && npm run db:migrate && npm run db:seed",
    "vision:generate": "prisma generate --schema apps/services/vision-service/prisma/schema.prisma",
    "vision:migrate": "nx run vision-service:migration",
    "vision:seed": "nx run vision-service:seed",
    "vision:probe-cameras": "python apps/services/vision-camera-agent/scripts/probe_cameras.py",
    "vision:smoke": "tsx apps/services/vision-camera-agent/scripts/smoke-test.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-express": "^11.1.28",
    "@prisma/client": "^6.19.3",
    "@xyflow/react": "^12.11.2",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.80.8",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "i18next": "^26.3.6",
    "intro.js": "^8.5.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.24.0",
    "pg": "^8.22.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-i18next": "^17.0.9",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.9.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.1",
    "ws": "^8.21.2",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@nx/esbuild": "^23.1.0",
    "@nx/eslint": "^23.1.0",
    "@nx/eslint-plugin": "^23.1.0",
    "@nx/js": "^23.1.0",
    "@nx/node": "^23.1.0",
    "@nx/vite": "^23.1.0",
    "@nx/workspace": "^23.1.0",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "4.1.17",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bcryptjs": "^3.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "22.19.15",
    "@types/pg": "^8.20.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.3",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "jest": "^29.7.0",
    "nx": "^23.1.0",
    "postcss": "8.5.8",
    "prettier": "^3.9.5",
    "prisma": "^6.19.3",
    "supertest": "^7.2.2",
    "tailwindcss": "4.1.17",
    "ts-jest": "^29.4.12",
    "tsx": "^4.23.1",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.1.4",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.10"
  }
}
