{
    "name":  "commerce-storefront-ui",
    "$schema":  "../../../../../node_modules/nx/schemas/project-schema.json",
    "projectType":  "library",
    "sourceRoot":  "libs/domains/commerce/storefront/ui/src",
    "targets":  {
                    "typecheck":  {
                                      "executor":  "nx:run-commands",
                                      "options":  {
                                                      "command":  "tsc --noEmit -p libs/domains/commerce/storefront/ui/tsconfig.json"
                                                  }
                                  },
                    "lint":  {
                                 "executor":  "nx:run-commands",
                                 "options":  {
                                                 "command":  "eslint libs/domains/commerce/storefront/ui/src"
                                             }
                             },
                    "test":  {
                                 "executor":  "nx:run-commands",
                                 "options":  {
                                                 "command":  "vitest run --config libs/domains/commerce/storefront/ui/vitest.config.ts"
                                             }
                             }
                },
    "tags":  [
                 "scope:commerce",
                 "platform:frontend",
                 "type:ui"
